@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box;-webkit-font-smoothing:antialiased}
body{background:#18181b;font-family:Inter,sans-serif;padding:40px 0}
.post{width:1080px;height:1350px;position:relative;overflow:hidden;background:#09090b;color:#fafafa;margin:0 auto 60px;display:flex;flex-direction:column}
.grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(39,39,42,.35) 1px,transparent 1px),linear-gradient(90deg,rgba(39,39,42,.35) 1px,transparent 1px);background-size:54px 54px;mask-image:radial-gradient(ellipse 100% 70% at 50% 0%,#000 40%,transparent 80%);-webkit-mask-image:radial-gradient(ellipse 100% 70% at 50% 0%,#000 40%,transparent 80%)}
.glow{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none}
.pad{position:relative;padding:80px 88px;height:100%;display:flex;flex-direction:column;z-index:2}
.logo-bar{display:flex;align-items:center;gap:14px;margin-bottom:auto}
.logo-icon{width:52px;height:52px;border-radius:12px;background:#c8ff00;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.logo-icon svg{width:32px;height:32px}
.logo-txt{font-size:20px;font-weight:700;letter-spacing:-.3px;color:#fafafa}
.logo-txt span{color:#52525b;font-weight:400;font-size:16px}
.badge{display:inline-flex;align-items:center;gap:9px;padding:8px 18px;border:1px solid #27272a;border-radius:999px;font-size:14px;color:#a1a1aa;width:fit-content}
.badge .dot{width:8px;height:8px;border-radius:50%;background:#c8ff00;flex-shrink:0}
.badge.lime{border-color:rgba(200,255,0,.3);background:rgba(200,255,0,.08);color:#c8ff00}
h1.big{font-size:88px;font-weight:800;letter-spacing:-3px;line-height:.96;margin-bottom:20px}
h1.mid{font-size:72px;font-weight:800;letter-spacing:-2.5px;line-height:.97;margin-bottom:20px}
h1.sml{font-size:58px;font-weight:800;letter-spacing:-2px;line-height:1.0;margin-bottom:20px}
.accent{color:#c8ff00}
.muted{color:#71717a}
.italic{font-style:italic;font-weight:300}
.sub{font-size:28px;color:#a1a1aa;line-height:1.5;font-weight:400}
.mono{font-family:'JetBrains Mono',monospace}
.url{font-size:22px;color:#52525b;font-family:'JetBrains Mono',monospace;letter-spacing:-.5px;margin-top:auto;padding-top:40px}
.url span{color:#c8ff00}
.divider{border:none;border-top:1px solid #27272a;margin:32px 0}
.tag{display:inline-block;padding:6px 14px;border-radius:8px;font-size:14px;font-family:'JetBrains Mono',monospace;background:rgba(200,255,0,.1);color:#c8ff00;border:1px solid rgba(200,255,0,.25)}
.pill{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:999px;font-size:16px;font-weight:600;border:1px solid #27272a;color:#a1a1aa}
.pill .d{width:8px;height:8px;border-radius:50%;background:#c8ff00}
.card-row{display:flex;gap:20px;flex:1;align-items:stretch}
.card-item{flex:1;background:#111113;border:1px solid #27272a;border-radius:20px;padding:32px;display:flex;flex-direction:column}
.card-item .icon{font-size:40px;margin-bottom:16px}
.card-item h3{font-size:26px;font-weight:700;margin-bottom:10px}
.card-item p{font-size:16px;color:#71717a;line-height:1.5}
.num-big{font-size:110px;font-weight:900;color:#c8ff00;line-height:1;letter-spacing:-5px;font-family:'JetBrains Mono',monospace}
.num-label{font-size:20px;color:#71717a;margin-top:4px}
.stats-row{display:flex;gap:0;border:1px solid #27272a;border-radius:20px;overflow:hidden}
.stat{flex:1;padding:36px 28px;border-right:1px solid #27272a}
.stat:last-child{border-right:none}
.stat .n{font-size:64px;font-weight:900;color:#c8ff00;font-family:'JetBrains Mono',monospace;letter-spacing:-3px;line-height:1}
.stat .l{font-size:16px;color:#71717a;margin-top:8px}
.table{width:100%;border-collapse:collapse;font-size:18px}
.table th{text-align:left;padding:16px 20px;color:#a1a1aa;font-weight:500;border-bottom:1px solid #27272a;font-size:15px}
.table td{padding:20px 20px;border-bottom:1px solid #18181b;vertical-align:middle}
.table tr:last-child td{border-bottom:none}
.table .check{color:#c8ff00;font-size:20px}
.table .cross{color:#52525b;font-size:20px}
.table .hl{color:#c8ff00;font-weight:600}
.step{display:flex;align-items:flex-start;gap:24px;padding:24px 0;border-bottom:1px solid #18181b}
.step:last-child{border-bottom:none}
.step-num{width:48px;height:48px;border-radius:12px;background:rgba(200,255,0,.1);border:1px solid rgba(200,255,0,.25);display:flex;align-items:center;justify-content:center;color:#c8ff00;font-weight:700;font-size:18px;font-family:monospace;flex-shrink:0}
.step-body h3{font-size:22px;font-weight:700;margin-bottom:6px}
.step-body p{font-size:16px;color:#71717a;line-height:1.5}
.cta-box{background:linear-gradient(135deg,rgba(200,255,0,.06),rgba(200,255,0,.02));border:1px solid rgba(200,255,0,.2);border-radius:24px;padding:48px;text-align:center;margin-top:auto}
.cta-box h2{font-size:48px;font-weight:800;letter-spacing:-1.5px;margin-bottom:16px}
.cta-box p{font-size:20px;color:#a1a1aa;margin-bottom:32px}
.btn{display:inline-block;padding:18px 40px;background:#c8ff00;color:#09090b;border-radius:12px;font-size:18px;font-weight:700;letter-spacing:-.3px}
.quote{font-size:42px;font-weight:700;letter-spacing:-1.5px;line-height:1.1;color:#fafafa;margin-bottom:24px}
.quote .q{color:#c8ff00;font-size:60px;line-height:0;vertical-align:-.3em}
.author{font-size:18px;color:#71717a}
.list-item{display:flex;align-items:flex-start;gap:20px;padding:22px 0;border-bottom:1px solid #18181b}
.list-item:last-child{border-bottom:none}
.list-num{color:#c8ff00;font-family:monospace;font-size:18px;font-weight:700;flex-shrink:0;width:32px}
.list-body h3{font-size:22px;font-weight:700;margin-bottom:5px}
.list-body p{font-size:16px;color:#71717a;line-height:1.5}
.vs-row{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:start;flex:1}
.vs-col{background:#111113;border:1px solid #27272a;border-radius:20px;padding:32px}
.vs-col.ours{border-color:rgba(200,255,0,.3);background:rgba(200,255,0,.04)}
.vs-col h3{font-size:22px;font-weight:700;margin-bottom:20px}
.vs-label{display:inline-block;padding:4px 12px;border-radius:6px;font-size:12px;font-family:monospace;letter-spacing:1px;text-transform:uppercase;margin-bottom:16px}
.vs-label.them{background:#27272a;color:#71717a}
.vs-label.us{background:rgba(200,255,0,.15);color:#c8ff00}
.vs-item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #18181b;font-size:16px}
.vs-item:last-child{border-bottom:none}
.vs-mid{display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:900;color:#52525b;padding-top:80px}
.code-block{background:#0a0a0c;border:1px solid #27272a;border-radius:16px;padding:28px 32px;font-family:'JetBrains Mono',monospace;font-size:17px;line-height:1.7}
.code-block .kw{color:#c8ff00}.code-block .str{color:#86efac}.code-block .cm{color:#52525b}
